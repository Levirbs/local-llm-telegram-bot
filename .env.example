# ===================================================
# CONFIGURAÇÕES DO TELEGRAM BOT & OLLAMA
# ===================================================

# Token obtido com o @BotFather no Telegram (Obrigatório)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Senha Master de Segurança (exigida para qualquer novo usuário)
BOT_MASTER_PASSWORD=sua_senha_secreta_aqui

# Configurações da API do Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:11b
OLLAMA_TIMEOUT=180

# Configurações do Whisper Offline (faster-whisper)
# Tamanhos recomendados: tiny, base, small
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Configurações do Banco de Dados SQLite
DATABASE_PATH=sessions.db

# Histórico de contexto enviado ao modelo (quantidade de últimas mensagens)
MAX_CONTEXT_MESSAGES=20

# Diretórios para armazenamento temporário (limpos compulsoriamente após uso)
TEMP_FILES_DIR=extracted_code
TEMP_AUDIO_DIR=temp_audio
