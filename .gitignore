# =====================================================================
# GITIGNORE - local-llm-telegram-bot
# =====================================================================

# --- Arquivos Sensíveis e Credenciais ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# --- Ambientes Virtuais (Virtual Environments) ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# --- Python Cache & Compilados ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Bancos de Dados SQLite & Arquivos Voláteis ---
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Diretórios Temporários de Processamento do Bot ---
extracted_code/
temp_audio/
temp_files/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Testes, Cobertura e Caches de Linters ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Caches de Modelos de IA e Hugging Face ---
.cache/
hf_home/
huggingface/
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# --- IDEs e Editores de Código ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Arquivos de Sistema Operacional ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Garantir que arquivos de exemplo e documentação não sejam ignorados ---
!.env.example
!media/
!media/*
